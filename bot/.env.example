# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token (xapp-...) - Socket Mode용
SLACK_APP_TOKEN=xapp-your-app-token

# 감시할 Slack 채널 ID (채널 설정 하단에서 확인 가능)
SLACK_CHANNEL_ID=your-channel-id

# 분석 트리거 이모지 (콜론 없이)
TRIGGER_EMOJI=robot_face

# Atlassian 사이트 URL (예: your-company.atlassian.net)
ATLASSIAN_SITE=your-company.atlassian.net

# Jira 프로젝트 키 (예: MYPROJECT)
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY

# claude -p 실행 시 작업 디렉토리 (workflow-kit 경로)
CLAUDE_WORK_DIR=/path/to/workflow-kit

# claude -p 요청당 최대 턴 수
CLAUDE_MAX_TURNS_TICKET=15
CLAUDE_MAX_TURNS_ANALYSIS=25
